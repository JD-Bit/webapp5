# Copy this file to secrets.toml in the same folder, then set your own key.
# Streamlit reads secrets.toml. It does not read this example.
#
# Preview uses the Asia/Singapore clock and only works when `key` matches
# preview_key. Without that match, ?preview= is ignored and the site looks
# as it does for everyone else.
#
#   http://localhost:8501/?preview=2027-01-01&key=YOUR_KEY
#   http://localhost:8501/?preview=2027-02-14T21:30&key=YOUR_KEY
#
# A date on its own means 00:00 that morning. Add T and a time when you
# need a later hour. The key can be up to 200 characters, with no spaces.
# Do not commit secrets.toml.

preview_key = ""
